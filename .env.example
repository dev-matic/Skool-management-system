# Copy this file to .env.local and adjust. Never commit real secrets.
# Values below match docker-compose.yml and are for LOCAL DEVELOPMENT ONLY.

# The app connects as the restricted "skool_app" role; row-level security
# keeps each school's data separate.
DATABASE_URL=postgres://skool_app:skool_app_dev_password@localhost:5432/skool_dev

# Migrations and the demo seed run as the database owner.
DATABASE_ADMIN_URL=postgres://skool:skool_dev_password@localhost:5432/skool_dev

# Signs session cookies. Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-plus-character-secret
# Public URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Hosted on Vercel with Neon (see docs/deploying.md): DATABASE_URL is the
# owner there, and the app connects as skool_app with this password instead.
# APP_DB_PASSWORD=
# On a hosted demo site, DEMO_SEED=1 adds the FAKE demo school on deploy.
# DEMO_SEED=

# Optional: password for demo users created by `pnpm db:seed`.
# SEED_PASSWORD=

# Integration tests use a separate database whose name must end in "_test";
# it is wiped and re-migrated on every run.
TEST_DATABASE_URL=postgres://skool_app:skool_app_dev_password@localhost:5432/skool_test
TEST_DATABASE_ADMIN_URL=postgres://skool:skool_dev_password@localhost:5432/skool_test
